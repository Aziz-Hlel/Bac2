
enum TimeOfDayEnum {
  MORNING
  EVENING
}

enum SubjectEnum {

  // LANGUAGES
  ARABIC
  FRENCH
  ENGLISH

  // SCIENCE
  MATH
  PHYSICS
  BIOLOGY
  TECHNOLOGY
  ALGORITHMS
  COMPUTER_SCIENCE


  // HUMANITIES
  HISTORY_GEOGRAPHY
  ECONOMICS
  FINANCE
  PHYLOSOPHY

  // SPORT
  SPORT

  // ELECTIVE
  SPANISH
  MUSIC
  ITALIAN
  MANDARIN
  GERMAN
}

enum ElectiveExamEnum {
  SPANISH
  MUSIC
  ITALIAN
  MANDARIN
  MATH
  GERMAN
}

enum MajorEnum {
  COMPUTER_SCIENCE
  MATH
  SCIENCE
  LETTRE
  TECHNIQUE
  ECO
  SPORT
}

enum TermEnum {
  PRINCIPAL
  RETAKE
}


model Major {
    id String @id @default(uuid()) @db.Uuid
    name MajorEnum @unique
    

    exams Exam[]
    schools SchoolMajors[]
    schoolsCapacities SchoolCapacityStats[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model ElectiveExam{
    id String @id @default(uuid()) @db.Uuid
    name ElectiveExamEnum @unique

    exams Exam[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}



model Exam {
    id String @id @default(uuid()) @db.Uuid
    subject SubjectEnum 

    date DateTime @db.Date
    startTime DateTime @db.Time
    endTime DateTime @db.Time
    timeOfDay TimeOfDayEnum
    term TermEnum 
    isOptional Boolean @default(false)


    majorId String? @db.Uuid
    major Major? @relation(fields: [majorId], references: [id])

    electiveExamId String? @db.Uuid
    electiveExam ElectiveExam? @relation(fields: [electiveExamId], references: [id], onDelete: Cascade) // * if exam is deleted, elective exam should be deleted

    examSessions ExamSession[]
    schoolsElectiveExams SchoolElectiveExam[]
    schoolCapacities SchoolCapacityStats[]
    
    @@index([term,subject,isOptional])
    
    @@unique([majorId,term,subject])


    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

}


enum CityEnum {
    SOUSSE
    TUNIS
    SFAX
    BIZERTE
    KAIROUAN
    GABES
    MONASTIR
    NABEUL
    BEJA
    JENDOUBA
    KEF
    SILIANA
    KASSERINE
    TOZEUR
    GAFSA
    MEDENINE
    TATAOUINE
    ZAGHOUAN
    MANOUBA
    ARIANA
    BEN_AROUS
}


model SchoolMajors{
    id String @id @default(uuid()) @db.Uuid

    schoolId String @db.Uuid
    school School @relation(fields: [schoolId], references: [id],onDelete: Cascade)

    majorId String @db.Uuid
    major Major @relation(fields: [majorId], references: [id],onDelete: Cascade)

    nbrClasses Int

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model SchoolElectiveExam{
    id String @id @default(uuid())
    
    schoolId String @db.Uuid
    school School @relation(fields: [schoolId], references: [id],onDelete: Cascade)
 
    examId String? @db.Uuid
    exam Exam? @relation(fields: [examId], references: [id],onDelete: Cascade)
    
    nbrClasses Int

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum CapacityTypeEnum {
  MAJOR
  ELECTIVE
}

model SchoolCapacityStats {
    id String @id @default(uuid())
    
    schoolId String @db.Uuid
    school School @relation(fields: [schoolId], references: [id],onDelete: Cascade)

    majorId String? @db.Uuid
    major Major? @relation(fields: [majorId], references: [id],onDelete: Cascade)

    examId String? @db.Uuid
    exam Exam? @relation(fields: [examId], references: [id],onDelete: Cascade)
    
    nbrClasses Int

    type CapacityTypeEnum

    @@unique([schoolId, majorId])
    @@unique([schoolId, examId])
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}


model School {
    id String @id @default(uuid()) @db.Uuid
    name String @db.VarChar(255)
    publicId String // @unique
    city CityEnum 

    userId String @unique
    user User @relation(fields: [userId], references: [id])

    majors SchoolMajors[]
    electiveExams SchoolElectiveExam[]
    capacities SchoolCapacityStats[]

    classes Class[]
    teachers Teacher[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}


model Class {
    id String @id @default(uuid()) @db.Uuid
    name String @db.VarChar(255)

    schoolId String @db.Uuid
    school School @relation(fields: [schoolId], references: [id])

    examSessions ExamSession[]

    @@unique([schoolId, name])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

