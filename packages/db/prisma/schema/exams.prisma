model Teacher{
  id String @id @default(uuid()) @db.Uuid
  publicId String @db.VarChar(255)
  lastName String @db.VarChar(255)
  firstName String @db.VarChar(255)
  
  isTeacher Boolean
  subject SubjectEnum?

  schoolId String @db.Uuid
  school School @relation(fields: [schoolId], references: [id])

  // teacherSchoolId String @db.Uuid
  // teacherSchool TeacherSchool @relation(fields: [teacherSchoolId], references: [id],onDelete: Cascade)

  primaryMaleTeacherExamSession TeacherExamSession[] @relation("PrimaryMaleTeacher")
  primaryFemaleTeacherExamSession TeacherExamSession[] @relation("PrimaryFemaleTeacher")
  secondaryTeacherExamSession TeacherExamSession[] @relation("SecondaryTeacher")

  teacherExamSession2 TeacherExamSession2[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
}


model ExamSession { 
  id String @id @default(uuid()) @db.Uuid

  classId String @db.Uuid
  class Class @relation(fields: [classId], references: [id],onDelete: Cascade)
  
  examId String @db.Uuid
  exam Exam @relation(fields: [examId], references: [id],onDelete: Cascade)

  teacherExamSession TeacherExamSession?
  teacherExamSession2 TeacherExamSession2[]

  @@unique([classId, examId])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SupervisorRole {
  PRIMARY_MALE
  PRIMARY_FEMALE
  SECONDARY
}

model TeacherExamSession2 {
  id String @id @default(uuid()) @db.Uuid

  supervisorId String @db.Uuid 
  supervisor Teacher @relation(fields: [supervisorId], references: [id])

  examSessionId String @db.Uuid
  examSession ExamSession @relation(fields: [examSessionId], references: [id],onDelete: Cascade)

  role SupervisorRole

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examSessionId, supervisorId, role])
}


model TeacherExamSession {
  id String @id @default(uuid()) @db.Uuid

  primaryMaleTeacherId String @db.Uuid 
  primaryMaleTeacher Teacher @relation("PrimaryMaleTeacher", fields: [primaryMaleTeacherId], references: [id])

  primaryFemaleTeacherId String @db.Uuid 
  primaryFemaleTeacher Teacher @relation("PrimaryFemaleTeacher", fields: [primaryFemaleTeacherId], references: [id])


  secondaryTeacherId String @db.Uuid 
  secondaryTeacher Teacher @relation("SecondaryTeacher", fields: [secondaryTeacherId], references: [id])

  examSessionId String @db.Uuid @unique
  examSession ExamSession @relation(fields: [examSessionId], references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}